generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                        String           @id @default(uuid())
  name                      String
  sku                       String
  country                   String?
  cost                      Float
  productWeight             Float
  sellerCoupon              Float            @default(0)
  adROI                     Float            @default(15)
  supplierTaxPoint          Float
  supplierInvoice           String
  sellerCouponPlatformRatio Float            @default(0)
  sellerCouponType          String           @default("fixed")
  userId                    String
  sites                     String[]         @default([])
  totalRevenue              Float            @default(0)
  platformInfrastructureFee Float            @default(0)
  siteData                  Json?
  user                      User             @relation(fields: [userId], references: [id])
  templates                 ProfitTemplate[]
}

model FinanceRecord {
  id          String   @id @default(uuid())
  date        DateTime
  type        String
  amount      Float
  category    String
  description String
  accountId   String
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model InventoryItem {
  id              String @id @default(uuid())
  name            String
  sku             String
  currentStock    Int
  stockOfficial   Int
  stockThirdParty Int
  inTransit       Int
  dailySales      Float
  leadTime        Int
  replenishCycle  Int
  costPerUnit     Float
  userId          String
  user            User   @relation(fields: [userId], references: [id])
}

model WarehouseMapping {
  id                    String  @id @default(uuid())
  officialWarehouseId   String?
  thirdPartyWarehouseId String?
  sku                   String
  type                  String
  userId                String
  user                  User    @relation(fields: [userId], references: [id])
}

model SkuGroup {
  id        String   @id @default(uuid())
  groupName String
  skus      String[]
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model RestockRecord {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  items     Json
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model ProfitTemplate {
  id        String   @id @default(uuid())
  name      String
  country   String
  data      Json
  createdAt DateTime @default(now())
  platform  String?
  type      String   @default("profit")
  userId    String
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model ScheduleItem {
  id          String    @id @default(uuid())
  type        String
  title       String
  description String?
  deadline    DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  notes       String?
  feedback    String?
  sortKey     Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  remindAt    DateTime?
  user        User      @relation(fields: [userId], references: [id])
}

model ChromaGenerationRecord {
  id           String   @id @default(uuid())
  mode         String
  model        String
  cost         Float
  prompt       String?
  parameters   Json?
  status       String
  errorMessage String?
  imageId      String?
  createdAt    DateTime @default(now())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
}

model ChromaImage {
  id           String   @id @default(uuid())
  filename     String
  originalName String?
  size         Int
  mode         String
  model        String
  createdAt    DateTime @default(now())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
}

model UserActivity {
  id        String   @id @default(uuid())
  userId    String
  action    String
  module    String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model User {
  id                String                   @id @default(uuid())
  username          String                   @unique
  password          String
  displayName       String
  role              String                   @default("viewer")
  parentId          String?
  isActive          Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  permissions       String[]                 @default([])
  avatar            String?
  email             String?
  phone             String?
  chromaRecords     ChromaGenerationRecord[]
  chromaImages      ChromaImage[]
  financeRecords    FinanceRecord[]
  inventoryItems    InventoryItem[]
  products          Product[]
  profitTemplates   ProfitTemplate[]
  restockRecords    RestockRecord[]
  scheduleItems     ScheduleItem[]
  skuGroups         SkuGroup[]
  parent            User?                    @relation("SubAccounts", fields: [parentId], references: [id])
  children          User[]                   @relation("SubAccounts")
  userActivities    UserActivity[]
  warehouseMappings WarehouseMapping[]
}
