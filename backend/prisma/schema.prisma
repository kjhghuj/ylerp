generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                        String                  @id @default(uuid())
  name                      String
  sku                       String
  country                   String?
  cost                      Float
  productWeight             Float
  ycLengthCm                Float?
  ycWidthCm                 Float?
  ycHeightCm                Float?
  ycVolumeM3                Float?
  ycSpecsSyncedAt           DateTime?
  vatRate                   Float                   @default(1)
  corporateIncomeTaxRate    Float                   @default(5)
  sellerCoupon              Float                   @default(0)
  adROI                     Float                   @default(15)
  supplierTaxPoint          Float
  supplierInvoice           String
  sellerCouponPlatformRatio Float                   @default(0)
  sellerCouponType          String                  @default("fixed")
  userId                    String
  sites                     String[]                @default([])
  totalRevenue              Float                   @default(0)
  platformInfrastructureFee Float                   @default(0)
  siteData                  Json?
  user                      User                    @relation(fields: [userId], references: [id])
  templates                 ProfitTemplate[]        @relation("LegacyProductTemplates")
  productTemplates          ProductProfitTemplate[]

  @@unique([userId, sku])
}

model FinanceRecord {
  id          String   @id @default(uuid())
  date        DateTime
  type        String
  amount      Float
  category    String
  description String
  accountId   String
  userId      String
  updatedBy   String?
  user        User     @relation(fields: [userId], references: [id])
}

model InventoryItem {
  id              String @id @default(uuid())
  name            String
  sku             String
  currentStock    Int
  stockOfficial   Int
  stockThirdParty Int
  inTransit       Int
  dailySales      Float
  leadTime        Int
  replenishCycle  Int
  costPerUnit     Float
  userId          String
  user            User   @relation(fields: [userId], references: [id])

  @@unique([userId, sku])
}

model WarehouseMapping {
  id                    String  @id @default(uuid())
  officialWarehouseId   String?
  thirdPartyWarehouseId String?
  sku                   String
  type                  String
  userId                String
  user                  User    @relation(fields: [userId], references: [id])

  @@unique([userId, type, sku, thirdPartyWarehouseId])
}

model SkuGroup {
  id        String   @id @default(uuid())
  groupName String
  skus      String[]
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model RestockRecord {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  items     Json
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model ProfitTemplate {
  id               String                  @id @default(uuid())
  name             String
  country          String
  data             Json
  createdAt        DateTime                @default(now())
  platform         String?
  type             String                  @default("profit")
  userId           String
  productId        String?
  product          Product?                @relation("LegacyProductTemplates", fields: [productId], references: [id])
  user             User                    @relation(fields: [userId], references: [id])
  productTemplates ProductProfitTemplate[]
}

model RestockSalesImport {
  id             String             @id @default(uuid())
  site           String
  fileName       String
  statisticsDays Int                @default(30)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          RestockSalesItem[]

  @@index([userId, site, createdAt])
}

model RestockSalesItem {
  id          String             @id @default(uuid())
  platformSku String?
  sourceSku   String?
  validSales  Float
  title       String?
  spec        String?
  shop        String?
  targetSku   String?
  dismissedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  importId    String
  salesImport RestockSalesImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@index([importId, targetSku])
  @@index([importId, dismissedAt])
}

model ExternalSkuMapping {
  id          String   @id @default(uuid())
  site        String
  externalSku String
  targetSku   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, site, externalSku])
  @@index([userId, site, targetSku])
}

model RestockSkuRule {
  id            String   @id @default(uuid())
  site          String
  sku           String
  leadTimeDays  Int?
  safetyDays    Int?
  growthPercent Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, site, sku])
  @@index([userId, site])
}

model ProductProfitTemplate {
  id         String          @id @default(uuid())
  productId  String
  templateId String?
  name       String
  country    String
  platform   String?
  isPrimary  Boolean   @default(false)
  data       Json
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  template   ProfitTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([productId, country])
  @@index([templateId])
}

model ScheduleItem {
  id          String    @id @default(uuid())
  type        String
  title       String
  description String?
  deadline    DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  notes       String?
  feedback    String?
  sortKey     Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  remindAt    DateTime?
  user        User      @relation(fields: [userId], references: [id])
}

model ChromaGenerationRecord {
  id           String   @id @default(uuid())
  mode         String
  model        String
  cost         Float
  prompt       String?
  parameters   Json?
  status       String
  errorMessage String?
  imageId      String?
  createdAt    DateTime @default(now())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
}

model ChromaImage {
  id           String   @id @default(uuid())
  filename     String
  originalName String?
  size         Int
  mode         String
  model        String
  createdAt    DateTime @default(now())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
}

model UserActivity {
  id        String   @id @default(uuid())
  userId    String
  action    String
  module    String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model NodeGraphTemplate {
  id        String   @id @default(uuid())
  name      String
  nodes     Json
  edges     Json
  country   String?
  platform  String?
  type      String   @default("profit")
  productId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model User {
  id                  String                   @id @default(uuid())
  username            String                   @unique
  password            String
  displayName         String
  role                String                   @default("viewer")
  parentId            String?
  isActive            Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  permissions         String[]                 @default([])
  avatar              String?
  email               String?
  phone               String?
  ycAppKey            String?
  ycAppSecret         String?
  chromaRecords       ChromaGenerationRecord[]
  chromaImages        ChromaImage[]
  financeRecords      FinanceRecord[]
  inventoryItems      InventoryItem[]
  nodeGraphTemplates  NodeGraphTemplate[]
  products            Product[]
  profitTemplates     ProfitTemplate[]
  restockRecords      RestockRecord[]
  restockSalesImports RestockSalesImport[]
  externalSkuMappings ExternalSkuMapping[]
  restockSkuRules     RestockSkuRule[]
  scheduleItems       ScheduleItem[]
  skuGroups           SkuGroup[]
  parent              User?                    @relation("SubAccounts", fields: [parentId], references: [id])
  children            User[]                   @relation("SubAccounts")
  userActivities      UserActivity[]
  warehouseMappings   WarehouseMapping[]
}
