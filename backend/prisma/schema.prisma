generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                        String                  @id @default(uuid())
  name                      String
  sku                       String
  country                   String?
  cost                      Float
  productWeight             Float
  ycLengthCm                Float?
  ycWidthCm                 Float?
  ycHeightCm                Float?
  ycVolumeM3                Float?
  ycSpecsSyncedAt           DateTime?
  vatRate                   Float                   @default(1)
  corporateIncomeTaxRate    Float                   @default(5)
  sellerCoupon              Float                   @default(0)
  adROI                     Float                   @default(15)
  supplierTaxPoint          Float
  supplierInvoice           String
  sellerCouponPlatformRatio Float                   @default(0)
  sellerCouponType          String                  @default("fixed")
  userId                    String
  sites                     String[]                @default([])
  totalRevenue              Float                   @default(0)
  platformInfrastructureFee Float                   @default(0)
  siteData                  Json?
  user                      User                    @relation(fields: [userId], references: [id])
  templates                 ProfitTemplate[]        @relation("LegacyProductTemplates")
  productTemplates          ProductProfitTemplate[]

  @@unique([userId, sku])
}

model FinanceRecord {
  id          String   @id @default(uuid())
  date        DateTime
  type        String
  amount      Float
  category    String
  description String
  accountId   String
  userId      String
  updatedBy   String?
  user        User     @relation(fields: [userId], references: [id])
}

model InventoryItem {
  id              String @id @default(uuid())
  name            String
  sku             String
  currentStock    Int
  stockOfficial   Int
  stockThirdParty Int
  inTransit       Int
  dailySales      Float
  leadTime        Int
  replenishCycle  Int
  costPerUnit     Float
  userId          String
  user            User   @relation(fields: [userId], references: [id])

  @@unique([userId, sku])
}

model WarehouseMapping {
  id                    String  @id @default(uuid())
  officialWarehouseId   String?
  thirdPartyWarehouseId String?
  sku                   String
  type                  String
  userId                String
  user                  User    @relation(fields: [userId], references: [id])

  @@unique([userId, type, sku, thirdPartyWarehouseId])
}

model SkuGroup {
  id        String   @id @default(uuid())
  groupName String
  skus      String[]
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model RestockRecord {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  items     Json
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model ProfitTemplate {
  id               String                  @id @default(uuid())
  name             String
  country          String
  data             Json
  createdAt        DateTime                @default(now())
  platform         String?
  type             String                  @default("profit")
  userId           String
  productId        String?
  product          Product?                @relation("LegacyProductTemplates", fields: [productId], references: [id])
  user             User                    @relation(fields: [userId], references: [id])
  productTemplates ProductProfitTemplate[]
}

model RestockSalesImport {
  id             String             @id @default(uuid())
  site           String
  fileName       String
  statisticsDays Int                @default(30)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          RestockSalesItem[]

  @@index([userId, site, createdAt])
}

model RestockSalesItem {
  id          String             @id @default(uuid())
  platformSku String?
  sourceSku   String?
  validSales  Float
  title       String?
  spec        String?
  shop        String?
  targetSku   String?
  dismissedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  importId    String
  salesImport RestockSalesImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@index([importId, targetSku])
  @@index([importId, dismissedAt])
}

model ExternalSkuMapping {
  id          String   @id @default(uuid())
  site        String
  externalSku String
  targetSku   String
  /// 编号类型（补货V3 人工映射绑定的身份）：modelCode/variationSku/item；legacy=历史字符串映射（身份未知）
  externalSkuType String @default("legacy")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, site, externalSku, externalSkuType])
  @@index([userId, site, targetSku])
}

model RestockSkuRule {
  id            String   @id @default(uuid())
  site          String
  sku           String
  leadTimeDays  Int?
  safetyDays    Int?
  growthPercent Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, site, sku])
  @@index([userId, site])
}

/// 补货V3：店铺专属 SKU 映射（店铺作用域，优先于站点级 ExternalSkuMapping；V2 读写不受影响）
model RestockShopSkuMapping {
  id          String                @id @default(uuid())
  userId      String
  shopId      String
  site        String
  externalSku String
  /// 编号类型（人工映射绑定的身份）：modelCode/variationSku/item；legacy=历史字符串映射（身份未知）
  externalSkuType String            @default("legacy")
  targetSku   String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop        ProductAnalysisShop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId, externalSku, externalSkuType])
  @@index([userId, shopId])
  @@index([userId, site])
}

/// 补货V3：店铺专属 SKU 参数规则（字段级覆盖：店铺规则 > 站点规则 > 全局参数）
model RestockShopRule {
  id            String              @id @default(uuid())
  userId        String
  shopId        String
  sku           String
  leadTimeDays  Int?
  safetyDays    Int?
  growthPercent Float?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop          ProductAnalysisShop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId, sku])
  @@index([userId, shopId])
}

/// 补货V3：库存池（命名的仓库范围；店铺=需求来源，池=供应来源）
model RestockStockPool {
  id             String   @id @default(uuid())
  userId         String
  name           String
  site           String
  warehouseCodes String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, site])
}

/// 补货V3：计算结果暂存（resultId 与用户/条件/源数据绑定；保存计划时服务端据此重建不可变快照）
model RestockComputeResult {
  id               String   @id @default(uuid())
  userId           String
  fingerprint      String
  sourceSnapshotId String
  payload          Json
  createdAt        DateTime @default(now())
  expiresAt        DateTime
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

/// 补货V3：补货计划快照（草稿→已确认→已作废；确认后修改生成新版本，历史保留）
model RestockPlanSnapshot {
  id             String    @id @default(uuid())
  userId         String
  name           String
  status         String    @default("draft")
  revision       Int       @default(1)
  version        Int       @default(1)
  resultId       String?
  idempotencyKey String?
  site           String
  shopIds        String[]
  poolId         String?
  warehouseCodes String[]
  rangeFrom      String
  rangeTo        String
  salesMetric    String    @default("unitsOrdered")
  parameters     Json
  items          Json
  summary        Json
  snapshotMeta   Json
  supersedesId   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  confirmedAt    DateTime?
  voidedAt       DateTime?
  voidReason     String?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, status, createdAt])
  @@index([userId, site])
}

model ProductProfitTemplate {
  id         String          @id @default(uuid())
  productId  String
  templateId String?
  name       String
  country    String
  platform   String?
  isPrimary  Boolean   @default(false)
  data       Json
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  template   ProfitTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([productId, country])
  @@index([templateId])
}

model ScheduleItem {
  id          String    @id @default(uuid())
  type        String
  title       String
  description String?
  deadline    DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  notes       String?
  feedback    String?
  sortKey     Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  remindAt    DateTime?
  user        User      @relation(fields: [userId], references: [id])
}

model ChromaGenerationRecord {
  id           String   @id @default(uuid())
  mode         String
  model        String
  cost         Float
  prompt       String?
  parameters   Json?
  status       String
  errorMessage String?
  imageId      String?
  createdAt    DateTime @default(now())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
}

model ChromaImage {
  id           String   @id @default(uuid())
  filename     String
  originalName String?
  size         Int
  mode         String
  model        String
  createdAt    DateTime @default(now())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
}

model UserActivity {
  id        String   @id @default(uuid())
  userId    String
  action    String
  module    String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model NodeGraphTemplate {
  id        String   @id @default(uuid())
  name      String
  nodes     Json
  edges     Json
  country   String?
  platform  String?
  type      String   @default("profit")
  productId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model ProductAnalysisReport {
  id          String   @id @default(uuid())
  fileName    String
  periodStart String?
  periodEnd   String?
  currency    String   @default("MYR")
  platform    String   @default("shopee")
  itemCount   Int      @default(0)
  data        Json
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

/// 商品分析店铺（一店一站，可多店）
model ProductAnalysisShop {
  id        String                    @id @default(uuid())
  name      String
  site      String
  platform  String                    @default("shopee")
  currency  String                    @default("MYR")
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  userId    String
  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  days      ProductAnalysisDailyUpload[]
  restockShopSkuMappings RestockShopSkuMapping[]
  restockShopRules       RestockShopRule[]

  @@unique([userId, name])
  @@index([userId])
}

/// 店铺单日上传版本；同日重传追加不可变版本，仅一个版本处于 active。
model ProductAnalysisDailyUpload {
  id        String             @id @default(uuid())
  shopId    String
  shop      ProductAnalysisShop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  date      DateTime           @db.Date
  fileName  String
  currency  String             @default("MYR")
  itemCount Int                @default(0)
  warnings  Json?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ProductDailyItem[]

  @@unique([shopId, date])
  @@index([shopId, date])
  @@index([userId])
}

/// 商品×天 一行；结构化列参与区间聚合，extra 存率类/商品属性，variations 存当日变体
model ProductDailyItem {
  id                String                    @id @default(uuid())
  uploadId          String
  upload            ProductAnalysisDailyUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  itemId            String
  itemName          String
  sheetKey          String
  status            String?
  salesOrdered      Float?
  salesConfirmed    Float?
  ordersOrdered     Float?
  ordersConfirmed   Float?
  unitsOrdered      Float?
  unitsConfirmed    Float?
  buyersOrdered     Float?
  buyersConfirmed   Float?
  impressions       Float?
  clicks            Float?
  uniqueImpressions Float?
  uniqueClicks      Float?
  visitors          Float?
  pageViews         Float?
  bounceVisitors    Float?
  searchClicks      Float?
  likes             Float?
  cartVisitors      Float?
  cartUnits         Float?
  extra             Json?
  variations        Json?

  @@unique([uploadId, itemId])
  @@index([uploadId, sheetKey])
}

model User {
  id                  String                   @id @default(uuid())
  username            String                   @unique
  password            String
  displayName         String
  role                String                   @default("viewer")
  parentId            String?
  isActive            Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  permissions         String[]                 @default([])
  avatar              String?
  email               String?
  phone               String?
  ycAppKey            String?
  ycAppSecret         String?
  aiChatBaseUrl       String?
  aiChatApiKeyEnc     String?
  aiChatModel         String?
  aiChatProvider      String?
  aiImageApiKeyEnc    String?
  aiImageBaseUrl      String?
  aiImageEndpoints    Json?
  chromaRecords       ChromaGenerationRecord[]
  chromaImages        ChromaImage[]
  financeRecords      FinanceRecord[]
  inventoryItems      InventoryItem[]
  nodeGraphTemplates  NodeGraphTemplate[]
  products            Product[]
  profitTemplates     ProfitTemplate[]
  productAnalysisReports ProductAnalysisReport[]
  productAnalysisShops   ProductAnalysisShop[]
  productAnalysisDailyUploads ProductAnalysisDailyUpload[]
  restockRecords      RestockRecord[]
  restockSalesImports RestockSalesImport[]
  externalSkuMappings ExternalSkuMapping[]
  restockSkuRules     RestockSkuRule[]
  restockShopSkuMappings RestockShopSkuMapping[]
  restockShopRules       RestockShopRule[]
  restockStockPools      RestockStockPool[]
  restockPlanSnapshots   RestockPlanSnapshot[]
  restockComputeResults  RestockComputeResult[]
  scheduleItems       ScheduleItem[]
  skuGroups           SkuGroup[]
  parent              User?                    @relation("SubAccounts", fields: [parentId], references: [id])
  children            User[]                   @relation("SubAccounts")
  userActivities      UserActivity[]
  warehouseMappings   WarehouseMapping[]
  shopeeConnections   ShopeeConnection[]
  shopeeAuthSessions  ShopeeAuthSession[]
}

model ShopeeAuthSession {
  id                   String   @id @default(uuid())
  userId               String
  stateHash            String   @unique
  appBinding           String
  status               String   @default("pending")
  expiresAt            DateTime
  shopId               String?
  pendingCredentials   String?
  confirmationHash     String?
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, status])
}

model ShopeeConnection {
  id                   String   @id @default(uuid())
  userId               String
  environment          String
  partnerId            String
  shopId               String
  shopName             String?
  region               String?
  encryptedCredentials String
  expiresAt            DateTime
  status               String   @default("active")
  lastError            String?
  refreshLeaseUntil    DateTime?
  nextRefreshAt        DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([environment, partnerId, shopId])
  @@index([userId])
  @@index([status, nextRefreshAt])
}

// Append-only operation ledger. Plain actor identifiers intentionally survive account deletion.
model UsageEvent {
  id             String   @id @default(uuid())
  actorId        String
  actorName      String?
  module         String
  action         String
  status         String   @default("success")
  source         String   @default("user")
  objectType     String?
  objectId       String?
  affectedCount  Int      @default(1)
  occurredAt     DateTime @default(now())
  eventKey       String   @unique
  metadata       Json?
  provenance     String   @default("native")
  legacySource   String?
  legacyId       String?
  migrationBatch String?
  ruleVersion    String?

  @@unique([legacySource, legacyId])
  @@index([actorId, occurredAt])
  @@index([module, status, occurredAt])
  @@index([provenance, occurredAt])
}

model AiUsageCall {
  id                String   @id @default(uuid())
  userId            String
  actorName         String?
  requestKey        String
  operationId       String
  requestHash       String
  kind              String
  module            String   @default("chroma")
  mode              String
  model             String
  status            String   @default("pending")
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  outputCount       Int      @default(0)
  estimatedCost     Decimal? @db.Decimal(18, 6)
  currency          String   @default("CNY")
  pricingVersion    String?
  providerRequestId String?
  deliveryStatus    String   @default("pending")
  storageStatus     String   @default("pending")
  imageIds          String[] @default([])
  result            Json?
  errorCode         String?
  errorMessage      String?
  provenance        String   @default("native")
  legacySource      String?
  legacyId          String?
  migrationBatch    String?
  ruleVersion       String?

  @@unique([userId, requestKey])
  @@unique([legacySource, legacyId])
  @@index([userId, startedAt])
  @@index([module, status, startedAt])
  @@index([provenance, startedAt])
  @@index([operationId])
}
