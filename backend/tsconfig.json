{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "..",
    "baseUrl": ".",
    "paths": {"xlsx": ["./node_modules/xlsx"]},
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "../shared/productAnalysis/**/*"
  ],
  "exclude": [
    "src/**/__tests__/**"
  ]
}
